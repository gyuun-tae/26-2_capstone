  {
   "id": "a12",
   "group": "answer",
   "question": "자유무역지역 입주계약 할 때 내야 하는 서류 알려줘",
   "answer_type": "answer",
   "top1_score": 0.78,
   "top_docs": [
    "YGPA-020",
