@@ -0,0 +1,40 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { streamChat } from './client'
+import { createSseParser } from './sse'
+import { fixtures } from './reviewWireFixtures'
+
+afterEach(() => vi.unstubAllGlobals())
+
+describe('API v0.2 captured wire compatibility', () => {
+  it.each(fixtures)('preserves every event at all character boundaries: $question', ({ wire }) => {
+    const whole = createSseParser()
+    const expected = [...whole.push(wire), ...whole.flush()]
+    expect(expected.length).toBeGreaterThan(0)
+    for (let split = 0; split <= wire.length; split++) {
+      const parser = createSseParser()
+      expect([...parser.push(wire.slice(0, split)), ...parser.push(wire.slice(split)), ...parser.flush()]).toEqual(expected)
+    }
+  })
+
+  it.each(fixtures)('client accepts terminal event: $question', async ({ question, wire }) => {
+    const bytes = new TextEncoder().encode(wire)
+    vi.stubGlobal('fetch', vi.fn(async () => new Response(new ReadableStream({
+      start(controller) {
+        // Include split UTF-8 characters and CRLF in real transport bytes.
+        for (const byte of bytes) controller.enqueue(new Uint8Array([byte]))
+        controller.close()
+      },
+    }), { headers: { 'Content-Type': 'text/event-stream' } })))
+    const request = streamChat({ messages: [{ role: 'user', content: question }] }, {
+      onToken: vi.fn(), onSources: vi.fn(),
+    })
+    if (question.includes('오류')) {
+      await expect(request).rejects.toMatchObject({ code: 'generation_failed' })
+    } else {
+      const done = await request
+      expect(done.answer_type).toBe(question.includes('조건') ? 'clarify' : question.includes('확인불가') ? 'unknown' : 'answer')
+      if (done.answer_type === 'clarify') expect(done.options?.length).toBeGreaterThan(0)
+      if (done.answer_type === 'answer') expect(done.actions?.length).toBeGreaterThan(0)
+    }
+  })
+})
