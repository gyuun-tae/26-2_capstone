--- /dev/null
+++ b/src/api/app/response.py
@@ -0,0 +1,58 @@
+"""Generate privately, verify, then release. No semantic verifier is implemented here."""
+import asyncio
+from dataclasses import dataclass
+
+from app.rag import Answer
+from app.schemas import AnswerType, Source
+
+ABSTENTION = "확인된 근거만으로 답변을 제공하기 어렵습니다. 공식 자료 또는 담당부서에 확인해 주세요."
+MAX_ANSWER_CHARS = 16000
+PREPARATION_TIMEOUT_SECONDS = 30
+
+
+@dataclass(frozen=True)
+class PreparedAnswer:
+    parts: tuple[str, ...]
+    sources: tuple[Source, ...]
+    answer_type: AnswerType
+
+    @property
+    def text(self) -> str:
+        return "".join(self.parts).strip()
+
+
+async def prepare_answer(result: Answer) -> PreparedAnswer:
+    """False means abstention; missing/broken verification means a technical error.
+
+    This buffers the whole draft; SSE transport remains, live generation tokens do not.
+    The caller persists only this finalized result before sending any answer content.
+    """
+    async with asyncio.timeout(PREPARATION_TIMEOUT_SECONDS):
+        parts = []
+        size = 0
+        async for part in result.tokens:
+            if not isinstance(part, str):
+                raise ValueError("Answer token must be text")
+            size += len(part)
+            if size > MAX_ANSWER_CHARS:
+                raise ValueError("Answer exceeds the output limit")
+            if part:
+                parts.append(part)
+        text = "".join(parts).strip()
+        if not text:
+            raise ValueError("Empty answer")
+        kind = result.answer_type  # The generator may finalize this during generation.
+        if kind not in {"answer", "clarify", "unknown"}:
+            raise ValueError("Invalid answer type")
+        sources = [source.model_copy(deep=True) for source in result.sources]
+        if result.verifier is None:
+            raise RuntimeError("Answer verifier is not configured")
+        # Pass copies so a verifier cannot silently alter the public response.
+        accepted = await result.verifier(text, [s.model_copy(deep=True) for s in sources])
+        if type(accepted) is not bool:
+            raise TypeError("Answer verifier must return bool")
+        if not accepted or (kind == "answer" and not sources):
+            return PreparedAnswer((ABSTENTION,), (), "unknown")
+        if kind == "unknown":
+            sources = []
+        return PreparedAnswer(tuple(parts), tuple(sources), kind)
