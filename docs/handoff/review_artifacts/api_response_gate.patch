@@ -0,0 +1,237 @@
+"""Synthetic change-safety tests. No FAQ content, model downloads or remote DB."""
+import asyncio
+import json
+import logging
+import os
+from pathlib import Path
+import runpy
+import tempfile
+import unittest
+from unittest.mock import patch
+
+RUNTIME = Path(tempfile.mkdtemp(prefix="ygpa-plan-tests-"))
+os.environ["DATABASE_URL"] = "sqlite:///" + (RUNTIME / "logs.db").as_posix()
+os.environ["CHROMA_PATH"] = str(RUNTIME / "chroma")
+os.environ["ANONYMIZED_TELEMETRY"] = "False"
+
+from fastapi.testclient import TestClient
+from sqlalchemy import func, select
+from sqlalchemy.orm import Session
+
+from app import main, rag, response, vectorstore
+from app.db import SessionLocal
+from app.models import ChatLog
+from app.schemas import ChatRequest
+
+logging.getLogger("app.main").setLevel(logging.CRITICAL)
+DRAFT = "합성 초안: 검증되지 않은 답변"
+
+
+async def accept(text, sources):
+    return True
+
+
+async def reject(text, sources):
+    return False
+
+
+def candidate(verifier=accept, *, text=DRAFT, kind="answer", sources=None):
+    async def tokens():
+        yield text
+
+    return rag.Answer(
+        sources=[s.model_copy(deep=True) for s in rag.MOCK_SOURCES] if sources is None else sources,
+        tokens=tokens(), answer_type=kind, verifier=verifier,
+    )
+
+
+def parse_sse(body):
+    result = []
+    for block in body.replace("\r\n", "\n").split("\n\n"):
+        fields = dict(line.split(": ", 1) for line in block.splitlines() if ": " in line and not line.startswith(":"))
+        if "event" in fields:
+            result.append((fields["event"], json.loads(fields["data"])))
+    return result
+
+
+def count_logs():
+    with SessionLocal() as db:
+        return db.scalar(select(func.count()).select_from(ChatLog))
+
+
+class PreparationTests(unittest.IsolatedAsyncioTestCase):
+    async def test_first_event_waits_for_verifier(self):
+        entered, release = asyncio.Event(), asyncio.Event()
+
+        async def delayed_verifier(text, sources):
+            entered.set()
+            await release.wait()
+            return True
+
+        with patch("app.main.rag.answer", return_value=candidate(delayed_verifier)):
+            stream = main.chat(ChatRequest(messages=[{"role": "user", "content": "synthetic"}]))
+            first = asyncio.create_task(anext(stream))
+            try:
+                await asyncio.wait_for(entered.wait(), 1)
+                self.assertFalse(first.done(), "Answer content leaked before verification")
+                release.set()
+                event = await asyncio.wait_for(first, 1)
+                self.assertEqual(event.event, "token")
+            finally:
+                if not first.done():
+                    first.cancel()
+                await stream.aclose()
+
+    async def test_cancel_before_verification_has_no_log(self):
+        entered = asyncio.Event()
+
+        async def waiting(text, sources):
+            entered.set()
+            await asyncio.Event().wait()
+
+        before = count_logs()
+        with patch("app.main.rag.answer", return_value=candidate(waiting)):
+            stream = main.chat(ChatRequest(messages=[{"role": "user", "content": "synthetic"}]))
+            first = asyncio.create_task(anext(stream))
+            await asyncio.wait_for(entered.wait(), 1)
+            first.cancel()
+            with self.assertRaises(asyncio.CancelledError):
+                await first
+            await stream.aclose()
+        self.assertEqual(count_logs(), before)
+
+    async def test_rejection_discards_text_and_sources(self):
+        out = await response.prepare_answer(candidate(reject))
+        self.assertEqual(out.answer_type, "unknown")
+        self.assertEqual(out.sources, ())
+        self.assertEqual(out.text, response.ABSTENTION)
+        self.assertNotIn(DRAFT, out.text)
+
+    async def test_answer_without_evidence_abstains_even_if_verifier_accepts(self):
+        out = await response.prepare_answer(candidate(sources=[]))
+        self.assertEqual(out.answer_type, "unknown")
+
+    async def test_final_type_is_read_after_generation(self):
+        result = candidate()
+
+        async def tokens():
+            yield "합성 확인 불가"
+            result.answer_type = "unknown"
+
+        result.tokens = tokens()
+        out = await response.prepare_answer(result)
+        self.assertEqual(out.answer_type, "unknown")
+        self.assertEqual(out.sources, ())
+
+    async def test_verifier_cannot_mutate_released_sources(self):
+        async def mutate(text, sources):
+            sources[0].title = "변조"
+            return True
+
+        out = await response.prepare_answer(candidate(mutate))
+        self.assertEqual(out.sources[0].title, rag.MOCK_SOURCES[0].title)
+
+    async def test_missing_verifier_is_not_implicit_approval(self):
+        with self.assertRaisesRegex(RuntimeError, "not configured"):
+            await response.prepare_answer(candidate(None))
+
+    async def test_non_boolean_verdict_is_rejected(self):
+        async def invalid(text, sources):
+            return "false"
+
+        with self.assertRaises(TypeError):
+            await response.prepare_answer(candidate(invalid))
+
+    async def test_empty_invalid_type_and_oversize_drafts_are_rejected(self):
+        for obj in (candidate(text=" "), candidate(kind="invalid"), candidate(text="x" * 16001)):
+            with self.subTest(kind=obj.answer_type), self.assertRaises(ValueError):
+                await response.prepare_answer(obj)
+
+    async def test_preparation_timeout(self):
+        async def slow(text, sources):
+            await asyncio.sleep(1)
+            return True
+
+        with patch("app.response.PREPARATION_TIMEOUT_SECONDS", 0.01):
+            with self.assertRaises(TimeoutError):
+                await response.prepare_answer(candidate(slow))
+
+
+class ApiCompatibilityTests(unittest.TestCase):
+    def setUp(self):
+        self.client = TestClient(main.app)
+        self.addCleanup(self.client.close)
+
+    def send(self, answer):
+        with patch("app.main.rag.answer", return_value=answer):
+            result = self.client.post("/chat", json={"messages": [{"role": "user", "content": "합성 검증 질문"}]})
+        self.assertEqual(result.status_code, 200)
+        return parse_sse(result.text)
+
+    def test_accepted_contract_and_persisted_content(self):
+        events = self.send(candidate())
+        self.assertEqual([e for e, _ in events], ["token", "sources", "done"])
+        self.assertEqual(events[-1][1]["answer_type"], "answer")
+        with SessionLocal() as db:
+            stored = db.get(ChatLog, events[-1][1]["message_id"])
+            self.assertEqual(stored.answer, DRAFT)
+            self.assertEqual(stored.sources, events[-2][1])
+
+    def test_rejected_draft_is_neither_sent_nor_logged(self):
+        events = self.send(candidate(reject))
+        self.assertNotIn(DRAFT, json.dumps(events, ensure_ascii=False))
+        self.assertEqual(events[-1][1]["answer_type"], "unknown")
+        self.assertEqual(events[-2][1], [])
+        with SessionLocal() as db:
+            stored = db.get(ChatLog, events[-1][1]["message_id"])
+            self.assertEqual(stored.answer, response.ABSTENTION)
+            self.assertEqual(stored.sources, [])
+
+    def test_commit_failure_releases_no_answer_content(self):
+        before = count_logs()
+        with patch.object(Session, "commit", side_effect=RuntimeError("synthetic database failure")):
+            events = self.send(candidate())
+        self.assertEqual([e for e, _ in events], ["error"])
+        self.assertEqual(count_logs(), before)
+
+    def test_verifier_exception_releases_no_content(self):
+        async def broken(text, sources):
+            raise RuntimeError("synthetic verifier failure")
+
+        before = count_logs()
+        self.assertEqual([e for e, _ in self.send(candidate(broken))], ["error"])
+        self.assertEqual(count_logs(), before)
+
+    def test_generation_failure_releases_no_partial_content(self):
+        async def broken_tokens():
+            yield DRAFT
+            raise RuntimeError("synthetic generation failure")
+
+        result = candidate()
+        result.tokens = broken_tokens()
+        self.assertEqual([e for e, _ in self.send(result)], ["error"])
+
+
+class StorageCompatibilityTests(unittest.TestCase):
+    def test_collection_requires_explicit_model_choice(self):
+        with self.assertRaises(TypeError):
+            vectorstore.get_collection()
+
+    def test_explicit_synthetic_vectors_roundtrip_without_model(self):
+        collection = vectorstore.get_collection("plan_synthetic", embedding_function=None)
+        self.addCleanup(vectorstore.client.delete_collection, "plan_synthetic")
+        collection.add(ids=["synthetic"], documents=["synthetic"], embeddings=[[1.0, 0.0]])
+        result = collection.query(query_embeddings=[[1.0, 0.0]], n_results=1)
+        self.assertEqual(result["ids"], [["synthetic"]])
+
+    def test_postgres_url_normalization_without_external_connection(self):
+        db_file = Path(main.__file__).with_name("db.py")
+        for prefix in ("postgres://", "postgresql://", "postgresql+psycopg://"):
+            with self.subTest(prefix=prefix), patch.dict(os.environ, {"DATABASE_URL": prefix + "example.invalid/test"}):
+                with patch("sqlalchemy.create_engine") as factory:
+                    runpy.run_path(str(db_file))
+                    factory.assert_called_once_with("postgresql+psycopg://example.invalid/test", pool_pre_ping=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
